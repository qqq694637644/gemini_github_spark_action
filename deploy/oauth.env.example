# Advanced multi-user OAuth/GitHub App deployment template.
# Keep secrets in the deployment platform's secret store.

APP_ENV=production
PUBLIC_BASE_URL=https://gateway.example.com
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=gateway.example.com
MCP_ALLOWED_ORIGINS=

MCP_AUTH_MODE=oauth
MCP_OAUTH_ISSUER_URL=https://identity.example.com/tenant
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_INTROSPECTION_URL=
MCP_OAUTH_INTROSPECTION_CLIENT_ID=
MCP_OAUTH_INTROSPECTION_CLIENT_SECRET=
MCP_OAUTH_AUDIENCE=https://gateway.example.com/mcp
MCP_OAUTH_ALGORITHMS=RS256,ES256
MCP_OAUTH_REQUIRED_SCOPES=github:read
MCP_OAUTH_REPO_CLAIM=github_repositories
MCP_OAUTH_REQUIRE_REPO_CLAIM=true
MCP_OAUTH_HTTP_TIMEOUT_SECONDS=10
MCP_OAUTH_JWKS_CACHE_SECONDS=300
MCP_OAUTH_CLOCK_SKEW_SECONDS=30

GITHUB_AUTH_MODE=github_app
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY=replace-with-private-key-from-secret-store
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_USE_ENV_PROXY=false

ALLOW_ALL_REPOS=false
ALLOWED_REPOS=owner/project-a
READ_BRANCH_ALLOWLIST=*
WRITE_BRANCH_PREFIX=spark/
DEFAULT_BASE_BRANCH=main
ALLOW_WORKFLOW_EDIT=false
ALLOW_DELETE_FILES=false

WORKSPACE_ROOT=/data/workspaces
WORKSPACE_OPERATION_ROOT=/data/operations
WORKSPACE_ALLOW_NETWORK=false
WORKSPACE_SHELL=pwsh
WORKSPACE_PYTHON_VENV_ENABLED=true
WORKSPACE_PYTHON_VENV_DIR=.venv
WORKSPACE_PYTHON_VENV_PYTHON=python3
WORKSPACE_PYTHON_AUTO_GITIGNORE=true
WORKSPACE_PYTHON_AUTO_ACTIVATE=true

AUDIT_DB_URL=sqlite:////data/audit.db
REQUEST_TIMEOUT_SECONDS=30
